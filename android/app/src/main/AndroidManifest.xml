<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for Supabase auth + REST in release builds. The debug
         manifest declares INTERNET for tooling; without it here the release
         APK silently fails network requests and main() hangs at
         signInAnonymously, leaving the user stuck on the Flutter splash. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Used by Google Mobile Ads for ad delivery/measurement. This must be
         disclosed in Play Console Advertising ID and Data safety sections. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

    <!-- Receipt capture via image_picker. Gallery selection uses the Android
         Photo Picker flow, so no broad media-read permission is needed. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Participant import uses flutter_native_contact_picker which opens
         the system contact picker intent. The user explicitly selects a
         contact, granting temporary read access to that contact only.
         No READ_CONTACTS permission required. -->

    <!-- Settlement reminders (M1/F4) via flutter_local_notifications.
         POST_NOTIFICATIONS is runtime-requested contextually when the first
         bill is saved (never at cold start). Inexact alarms only — no
         SCHEDULE_EXACT_ALARM needed. Disclose in Play Console Data safety
         only if reminder content is ever enriched beyond bill title/total. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Bagi Struk"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <!-- Google Mobile Ads Android App ID. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-4082765898994990~1671692391" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data
                    android:scheme="bagistruk"
                    android:host="auth"
                    android:path="/callback"/>
            </intent-filter>
        </activity>
        <!-- Share target "Scan receipt": appears in the Android share sheet
             when the user shares images. Routes SEND / SEND_MULTIPLE into
             MainActivity (singleTop), where receive_sharing_intent picks the
             files up. A separate activity-alias (instead of filters on the
             activity) gives the share entry its own label without renaming
             the launcher icon. -->
        <activity-alias
            android:name=".ScanReceipt"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="Scan receipt"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
